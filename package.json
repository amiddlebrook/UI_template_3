{
  "name": "morphogenetic-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm run build && npm test",
    "preview": "vite preview --host 0.0.0.0",
    "deploy": "npm run check && wrangler deploy"
  },
  "dependencies": {
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "recharts": "3.5.1",
    "lucide-react": "0.556.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wrangler": "^4.0.0"
  }
}
